# Python
__pycache__/
*.py[cod]
.pytest_cache/

# SQLite
*.db
*.sqlite
viamonte.db
# Con journal_mode=WAL (ver database.py), SQLite guarda los cambios recientes
# acá antes de volcarlos a viamonte.db: sin ignorarlos, un commit podría
# versionar datos de producción que ni siquiera están en el .db todavía.
*.db-wal
*.db-shm

# Copias de resguardo de la base (las que dejan las migraciones al correr)
backups/

# Archivos adjuntos subidos desde el Kanban (fotos, PDFs de arte). Viven bajo
# DIR_DATOS/uploads (ver archivos.py), la misma carpeta escribible que
# viamonte.db: son datos de producción, no código ni assets del repo.
uploads/

# Entornos virtuales
venv/
.venv/

# VS Code
.vscode/

# Variables de entorno
.env

# Clave con la que se firman los tokens de sesión. La genera seguridad.py la
# primera vez que arranca el sistema y es distinta en cada instalación:
# commitearla dejaría que cualquiera con el repo se fabrique un token válido.
.secret_key

# PyInstaller (empaquetado del .exe)
build/
dist/
# El .spec NO se ignora: no es un artefacto de build sino la configuración
# para generarlo (incluye datas de frontend/ y los hooks de reportlab). Si se
# pierde, hay que reconstruirla a mano. El proyecto genera uno solo
# (GraficaViamonte.spec) y a mano, así que no hace falta la excepción de un
# patrón *.spec que ignoraría en silencio cualquier .spec nuevo.

# Archivos generales que no deben subirse
AUDITORIA_GLOBAL_QA.md
auditoria.py
calculos.py
DEMO_SETUP.md
poblar_base_ejemplo.py
seguridad.py