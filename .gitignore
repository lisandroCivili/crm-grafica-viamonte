# VS Code
.vscode/

# Variables de entorno
.env

# Clave con la que se firman los tokens de sesión. La genera seguridad.py la
# primera vez que arranca el sistema y es distinta en cada instalación:
# commitearla dejaría que cualquiera con el repo se fabrique un token válido.
.secret_key

# PyInstaller (empaquetado del .exe)
build/
dist/
*.spec
# El .spec del proyecto SÍ se versiona: no es un artefacto de build sino la
# configuración para generarlo (incluye datas de frontend/ y los hooks de
# reportlab). Si se pierde, hay que reconstruirla a mano.
!GraficaViamonte.spec